{
  "expo": {
    "name": "PopStack",
    "slug": "popstack",
    "version": "1.0.0",
    "scheme": "popstack",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6C2FFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c207c9d3-c842-488b-8b50-fa37ab4aeea6"
      }
    }
  }
}
